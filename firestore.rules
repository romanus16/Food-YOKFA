rules_version = '2';

// Règles de départ. Elles seront affinées avec le modèle de données (issue #2).
// Un gérant est un utilisateur dont le jeton porte la revendication `gerant: true`
// (à poser depuis la console Firebase ou un script d'administration).
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() {
      return request.auth != null;
    }
    function gerant() {
      return connecte() && request.auth.token.gerant == true;
    }

    // Menu : lisible par tous, modifiable par les gérants.
    match /categories/{id} {
      allow read: if true;
      allow write: if gerant();
    }
    match /produits/{id} {
      allow read: if true;
      allow write: if gerant();
    }

    // Commandes : le client crée et lit les siennes, le gérant lit et met à jour.
    match /commandes/{id} {
      allow create: if connecte() && request.resource.data.clientId == request.auth.uid;
      allow read: if gerant() || (connecte() && resource.data.clientId == request.auth.uid);
      allow update: if gerant();
      allow delete: if false;
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
